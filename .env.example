# Serveur (routes /api) : ne jamais préfixer par EXPO_PUBLIC_
ANTHROPIC_API_KEY=
# Modèles Claude : analyse (claude-sonnet-5-5 par défaut) et chat de suivi (claude-haiku-5-5)
CLAUDE_MODEL_ANALYSIS=
CLAUDE_MODEL_CHAT=
# Secret de signature des sessions (HMAC-SHA256). Obligatoire en production (sinon 503).
# Générez-le avec : openssl rand -base64 48   — ne le changez pas sans transition :
# mettez l'ancien dans SESSION_SECRET_PREVIOUS, sinon chaque appareil reçoit un nouvel identifiant.
SESSION_SECRET=
SESSION_SECRET_PREVIOUS=
# Compteurs des quotas gratuits, crédits et limites de débit (Upstash Redis, API REST).
# Sans eux : stockage en mémoire, par instance, non fiable en production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Origines web autorisées à appeler /api depuis un navigateur (liste séparée par des virgules).
# Les apps natives (sans en-tête Origin) et la même origine que le serveur sont toujours acceptées.
ALLOWED_ORIGINS=
# Vérification de l'abonnement Premium et des diagnostics à l'unité côté serveur (obligatoire en production)
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT=premium
# Identifiants store du produit consommable « une panne » (paquet diag_unit), séparés par des virgules
REVENUECAT_CREDIT_PRODUCT_IDS=diag_unit
# Fournisseur de données SIV pour l'identification par la plaque
PLATE_API_URL=
PLATE_API_KEY=

# App : clés publiques RevenueCat. Sans elles, Premium est en mode démo.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_KEY=
# Paramètres d'affiliation ajoutés aux liens partenaires (ex. "aff=12345")
EXPO_PUBLIC_AFFILIATE_OSCARO=
EXPO_PUBLIC_AFFILIATE_MISTERAUTO=
EXPO_PUBLIC_AFFILIATE_AUTODOC=
EXPO_PUBLIC_AFFILIATE_VROOMLY=
EXPO_PUBLIC_AFFILIATE_IDGARAGE=
